<?xml version="1.0" encoding="UTF-8"?>
<deployment xmlns="http://xml.apache.org/axis/wsdd/" xmlns:java="http://xml.apache.org/axis/wsdd/providers/java">
 <globalConfiguration>
  <parameter name="sendMultiRefs" value="true"/>
  <parameter name="disablePrettyXML" value="true"/>
  <parameter name="adminPassword" value="admin"/>
  <parameter name="attachments.Directory" value="C:\WorkTools\apache-tomcat-5.5.25\webapps\axis\WEB-INF\attachments"/>
  <parameter name="dotNetSoapEncFix" value="true"/>
  <parameter name="enableNamespacePrefixOptimization" value="false"/>
  <parameter name="sendXMLDeclaration" value="true"/>
  <parameter name="sendXsiTypes" value="true"/>
  <parameter name="attachments.implementation" value="org.apache.axis.attachments.AttachmentsImpl"/>
  <requestFlow>
   <handler type="java:org.apache.axis.handlers.JWSHandler">
    <parameter name="scope" value="session"/>
   </handler>
   <handler type="java:org.apache.axis.handlers.JWSHandler">
    <parameter name="scope" value="request"/>
    <parameter name="extension" value=".jwr"/>
   </handler>
  </requestFlow>
 </globalConfiguration>
 <handler name="URLMapper" type="java:org.apache.axis.handlers.http.URLMapper"/>
 <handler name="LocalResponder" type="java:org.apache.axis.transport.local.LocalResponder"/>
 <handler name="Authenticate" type="java:org.apache.axis.handlers.SimpleAuthenticationHandler"/>
 <service name="DCCSoap" provider="java:RPC" style="wrapped" use="literal">
  <operation name="getRateQuote" qname="ns1:GetRateQuote" returnQName="ns1:GetRateQuoteResult" returnType="ns1:GetRateQuoteResult" soapAction="http://dcc.com/webservices/GetRateQuote" xmlns:ns1="http://dcc.com/webservices/">
   <parameter qname="ns1:MerchantID" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <parameter qname="ns1:ValidationCode" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <parameter qname="ns1:CardNumber" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <parameter qname="ns1:MerchantAmount" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <parameter qname="ns1:MerchantCurrency" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
  </operation>
  <operation name="getRateQuoteDetail" qname="ns2:GetRateQuoteDetail" returnQName="ns2:GetRateQuoteDetailResult" returnType="ns2:GetRateQuoteDetailResult" soapAction="http://dcc.com/webservices/GetRateQuoteDetail" xmlns:ns2="http://dcc.com/webservices/">
   <parameter qname="ns2:MerchantID" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <parameter qname="ns2:ValidationCode" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <parameter qname="ns2:RateQuoteID" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
  </operation>
  <operation name="getTimeInformation" qname="ns3:GetTimeInformation" returnQName="ns3:GetTimeInformationResult" returnType="ns3:GetTimeInformationResult" soapAction="http://dcc.com/webservices/GetTimeInformation" xmlns:ns3="http://dcc.com/webservices/">
   <parameter qname="ns3:MerchantID" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <parameter qname="ns3:ValidationCode" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
  </operation>
  <operation name="reportTx" qname="ns4:ReportTx" returnQName="ns4:ReportTxResult" returnType="ns4:ReportTxResult" soapAction="http://dcc.com/webservices/ReportTx" xmlns:ns4="http://dcc.com/webservices/">
   <parameter qname="ns4:MerchantID" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <parameter qname="ns4:ValidationCode" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <parameter qname="ns4:MerchantAmount" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <parameter qname="ns4:MerchantCurrency" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <parameter qname="ns4:CardAmount" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <parameter qname="ns4:CardCurrency" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <parameter qname="ns4:RateQuoteID" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <parameter qname="ns4:CustomField1" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <parameter qname="ns4:CustomField2" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <parameter qname="ns4:ShiftDate" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <parameter qname="ns4:SubmissionDate" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
  </operation>
  <operation name="cancelTx" qname="ns5:CancelTx" returnQName="ns5:CancelTxResult" returnType="ns5:CancelTxResult" soapAction="http://dcc.com/webservices/CancelTx" xmlns:ns5="http://dcc.com/webservices/">
   <parameter qname="ns5:MerchantID" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <parameter qname="ns5:ValidationCode" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <parameter qname="ns5:TxID" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
  </operation>
  <operation name="getTxDetail" qname="ns6:GetTxDetail" returnQName="ns6:GetTxDetailResult" returnType="ns6:GetTxDetailResult" soapAction="http://dcc.com/webservices/GetTxDetail" xmlns:ns6="http://dcc.com/webservices/">
   <parameter qname="ns6:MerchantID" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <parameter qname="ns6:ValidationCode" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
   <parameter qname="ns6:TxID" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
  </operation>
  <parameter name="wsdlServicePort" value="DCCSoap"/>
  <parameter name="schemaQualified" value="http://dcc.com/webservices/"/>
  <parameter name="className" value="com.cccint.test.testtool.soap.dcc.server.DCCSoap_BindingImpl"/>
  <parameter name="typeMappingVersion" value="1.2"/>
  <parameter name="allowedMethods" value="getRateQuote reportTx cancelTx getTxDetail getTimeInformation getRateQuoteDetail"/>
  <parameter name="wsdlServiceElement" value="DCC"/>
  <parameter name="wsdlTargetNamespace" value="http://dcc.com/webservices/"/>
  <parameter name="wsdlPortType" value="DCCSoap"/>
  <parameter name="scope" value="Request"/>
  <typeMapping deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory" encodingStyle="" qname="ns7:GetTimeInformationResult" serializer="org.apache.axis.encoding.ser.BeanSerializerFactory" type="java:com.cccint.test.testtool.soap.dcc.server.GetTimeInformationResult" xmlns:ns7="http://dcc.com/webservices/"/>
  <typeMapping deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory" encodingStyle="" qname="ns8:ReportTxResult" serializer="org.apache.axis.encoding.ser.BeanSerializerFactory" type="java:com.cccint.test.testtool.soap.dcc.server.ReportTxResult" xmlns:ns8="http://dcc.com/webservices/"/>
  <typeMapping deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory" encodingStyle="" qname="ns9:CancelTxResult" serializer="org.apache.axis.encoding.ser.BeanSerializerFactory" type="java:com.cccint.test.testtool.soap.dcc.server.CancelTxResult" xmlns:ns9="http://dcc.com/webservices/"/>
  <typeMapping deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory" encodingStyle="" qname="ns10:GetRateQuoteResult" serializer="org.apache.axis.encoding.ser.BeanSerializerFactory" type="java:com.cccint.test.testtool.soap.dcc.server.GetRateQuoteResult" xmlns:ns10="http://dcc.com/webservices/"/>
  <typeMapping deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory" encodingStyle="" qname="ns11:GetTxDetailResult" serializer="org.apache.axis.encoding.ser.BeanSerializerFactory" type="java:com.cccint.test.testtool.soap.dcc.server.GetTxDetailResult" xmlns:ns11="http://dcc.com/webservices/"/>
  <typeMapping deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory" encodingStyle="" qname="ns12:GetRateQuoteDetailResult" serializer="org.apache.axis.encoding.ser.BeanSerializerFactory" type="java:com.cccint.test.testtool.soap.dcc.server.GetRateQuoteDetailResult" xmlns:ns12="http://dcc.com/webservices/"/>
 </service>
 <service name="AdminService" provider="java:MSG">
  <parameter name="allowedMethods" value="AdminService"/>
  <parameter name="enableRemoteAdmin" value="false"/>
  <parameter name="className" value="org.apache.axis.utils.Admin"/>
  <namespace>http://xml.apache.org/axis/wsdd/</namespace>
 </service>
 <service name="Version" provider="java:RPC">
  <parameter name="allowedMethods" value="getVersion"/>
  <parameter name="className" value="org.apache.axis.Version"/>
 </service>
 <transport name="http">
  <requestFlow>
   <handler type="URLMapper"/>
   <handler type="java:org.apache.axis.handlers.http.HTTPAuthHandler"/>
  </requestFlow>
  <parameter name="qs:list" value="org.apache.axis.transport.http.QSListHandler"/>
  <parameter name="qs:wsdl" value="org.apache.axis.transport.http.QSWSDLHandler"/>
  <parameter name="qs.list" value="org.apache.axis.transport.http.QSListHandler"/>
  <parameter name="qs.method" value="org.apache.axis.transport.http.QSMethodHandler"/>
  <parameter name="qs:method" value="org.apache.axis.transport.http.QSMethodHandler"/>
  <parameter name="qs.wsdl" value="org.apache.axis.transport.http.QSWSDLHandler"/>
 </transport>
 <transport name="local">
  <responseFlow>
   <handler type="LocalResponder"/>
  </responseFlow>
 </transport>
</deployment>
